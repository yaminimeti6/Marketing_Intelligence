{
  "name": "northstar-marketing-intelligence",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:browser": "playwright test",
    "db:migrate": "node --env-file=.env --experimental-strip-types scripts/migrate.ts",
    "db:bootstrap": "node --env-file=.env --experimental-strip-types scripts/bootstrap.ts",
    "worker": "node --experimental-strip-types scripts/worker.ts",
    "worker:shopify": "node --experimental-strip-types scripts/shopify-worker.ts",
    "shopify:check": "node --experimental-strip-types scripts/check-shopify-setup.mjs",
    "worker:shopify:watch": "node scripts/watch-shopify.mjs",
    "shopify:pixel:setup": "node --experimental-strip-types scripts/configure-shopify-pixel.ts",
    "workers:watch": "node --experimental-strip-types scripts/watch-workers.mjs",
    "worker:rules": "node --experimental-strip-types scripts/rules-worker.ts",
    "setup:check": "node --experimental-strip-types scripts/check-setup.mjs",
    "email:check": "node --env-file=.env --experimental-strip-types scripts/check-email.mjs",
    "shopify:reconcile": "node --experimental-strip-types scripts/check-shopify-reconciliation.ts"
  },
  "dependencies": {
    "@shopify/shopify-api": "^15.0.1",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0"
  },
  "type": "module"
}
