# Copy to .env. Replace all password/key placeholders before starting PostgreSQL.
# Template only: never put real credentials in this file or share .env in chat.
# Setup order: PostgreSQL -> local .env/key generation -> migration -> owner account.
# Leave DATABASE_URL unset until the real database is ready; placeholders do not connect.
# Both native Windows PostgreSQL and Docker use the URLs below.
# POSTGRES_PASSWORD / APP_DB_PASSWORD configure Docker initialization only;
# native PostgreSQL role passwords are configured privately through psql.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
DATABASE_URL=postgresql://northstar_app:REPLACE_URL_ENCODED_PASSWORD@127.0.0.1:5432/northstar
MIGRATION_DATABASE_URL=postgresql://northstar_migrator:REPLACE_URL_ENCODED_PASSWORD@127.0.0.1:5432/northstar
APP_ORIGIN=http://127.0.0.1:3000
# Generate 32 cryptographically random bytes locally; store only in private .env.
# Do not print the encryption key into shared logs or paste it into chat.
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_ID=local-v1
# Used only by npm run db:bootstrap. Do not use sample credentials.
BOOTSTRAP_EMAIL=
BOOTSTRAP_NAME=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_WORKSPACE=

# Milestone 2: Meta Ads. Placeholders only; real values belong in private .env.
# Never put App Secret or access tokens in NEXT_PUBLIC_ variables.
META_APP_ID=
META_APP_SECRET=
# Pin the supported version shown in your Meta app/dashboard; do not guess it.
META_GRAPH_API_VERSION=
# Exact HTTPS callback must be registered in Meta before enabling OAuth.
META_REDIRECT_URI=
# Set only if the selected Facebook Login for Business flow requires it.
META_LOGIN_CONFIG_ID=
# Existing Owner/Admin user UUID for the read-only Meta worker; never a DB superuser.
META_WORKER_USER_ID=

# Shopify preparation. Real values belong only in private .env.
# Use the permanent *.myshopify.com domain, not the storefront custom domain.
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Explicit supported YYYY-MM stable version, confirmed during setup.
SHOPIFY_API_VERSION=
# Exact HTTPS callback: /api/integrations/shopify/callback (register after confirming app setup).
SHOPIFY_REDIRECT_URI=
# Existing Owner/Admin UUID for the independent Shopify import worker.
SHOPIFY_WORKER_USER_ID=

# Optional manager/MCC routing root, exactly 10 digits without dashes.
# Existing Northstar Owner/Admin UUID for the independent worker.

# Local recurring imports; provider rate limits can delay completion.
SYNC_INTERVAL_SECONDS=60

# Optional separate Owner/Admin identity for in-app rule evaluation.
# If empty, the rules worker reuses the first configured provider worker identity.
RULES_WORKER_USER_ID=

# Optional invitation email delivery; server-only, never NEXT_PUBLIC_
RESEND_API_KEY=
# Plain sender address verified in Resend
EMAIL_FROM=
# Public HTTPS origin without a path; must be reachable by invite recipients
APP_URL=

# Set only after confirming ALL paid marketing channels for MER.
# Allowed: meta. Leave empty while spend coverage is unknown.
MER_CHANNELS=

# Optional AI Assistant; server-only OpenAI API key, billed separately from ChatGPT
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional image generation model; separate from text model
OPENAI_IMAGE_MODEL=gpt-image-1-mini

# Explicit opt-in for reviewed Meta advertising mutations (requires ads_management)
META_AD_WRITES_ENABLED=false
# Scheduled report worker identity (optional; defaults to the Meta/Shopify worker identity)
REPORTS_WORKER_USER_ID=
